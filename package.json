{
  "name": "wtms",
  "version": "1.0.0",
  "description": "Work Time Management System",
  "author": "Lucid The Artistry",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "node launch.js",
    "build": "electron-builder build --win --x64",
    "build:dir": "electron-builder build --win --x64 --dir"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.lucidtheartistry.wtms",
    "productName": "WTMS",
    "copyright": "Copyright © 2026 Lucid The Artistry",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.log",
      "!*.rar",
      "!*.ps1",
      "!.git/**",
      "!PRD.md",
      "!nul",
      "!build.bat",
      "!electron-splash.html",
      "electron-splash.html"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WTMS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": null,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "assets/installer.nsh"
    }
  }
}
